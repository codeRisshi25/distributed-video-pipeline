{
  "name": "@vid_converter/workers",
  "version": "1.0.0",
  "description": "BullMQ worker process for vid_converter — processes FFmpeg video conversion jobs",
  "type": "module",
  "main": "./dist/worker.js",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "tsc --build",
    "start": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@vid_converter/shared": "workspace:*",
    "bullmq": "^5.76.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.0"
  }
}
